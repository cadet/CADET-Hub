#!/bin/bash
# Clone the workshop repository into the home folder of a workshop user.
#
# The hub's pre_spawn_hook sets WORKSHOP_REPOSITORY, WORKSHOP_BRANCH and WORKSHOP_FOLDER (the
# teaching branch) and optionally WORKSHOP_SOLUTION_BRANCH and WORKSHOP_SOLUTION_FOLDER for
# members of a workshop group (see projects.yaml). Without them, nothing happens.
#
# Each branch is only cloned if its folder does not exist yet. Participants' own changes are
# never merged with upstream on server start; to update a notebook, they delete it and open the
# nbgitpuller link, which restores it from the repository.

if [ -z "${WORKSHOP_REPOSITORY:-}" ]; then
    exit 0
fi

# clone BRANCH FOLDER
clone() {
    local branch="$1"
    local target="${HOME}/$2"
    if [ -e "${target}" ]; then
        echo "workshop-pull: ${target} exists, not cloning again."
        return 0
    fi
    echo "workshop-pull: cloning ${WORKSHOP_REPOSITORY} (${branch:-default branch}) into ${target}."
    (cd "${HOME}" && timeout 300 gitpuller "${WORKSHOP_REPOSITORY}" ${branch:+"${branch}"} "${target}")
}

status=0
clone "${WORKSHOP_BRANCH:-}" "${WORKSHOP_FOLDER:-$(basename "${WORKSHOP_REPOSITORY}" .git)}" || status=1
if [ -n "${WORKSHOP_SOLUTION_BRANCH:-}" ]; then
    clone "${WORKSHOP_SOLUTION_BRANCH}" "${WORKSHOP_SOLUTION_FOLDER:-solution}" || status=1
fi
exit ${status}
